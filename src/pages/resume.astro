---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout 
  title="Resume"
  description="Resume of Nitesh Sharma - Technical Architect / Solutions Architect with 11+ years of experience in distributed systems and microservices."
>
  <div class="min-h-screen bg-white dark:bg-gray-900 print:bg-white">
    <div class="no-print sticky top-0 z-50 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-4 py-3">
      <div class="container mx-auto flex justify-between items-center">
        <a href="/nitesh-portfolio/" class="text-accent-600 dark:text-accent-400 hover:underline">
          ← Back to Portfolio
        </a>
        <button
          onclick="window.print()"
          class="inline-flex items-center px-4 py-2 bg-accent-600 hover:bg-accent-700 text-white font-medium rounded-lg transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print / Save as PDF
        </button>
      </div>
    </div>
    
    <div class="container mx-auto px-4 py-8 max-w-4xl print:px-0 print:py-0 print:max-w-none">
      <article class="bg-white dark:bg-gray-900 print:bg-white text-gray-900 dark:text-gray-100 print:text-gray-900">
        <!-- Header -->
        <header class="mb-6 pb-6 border-b-2 border-gray-300 print:mb-4 print:pb-4">
          <h1 class="text-4xl font-bold mb-2 print:text-3xl">Nitesh Sharma</h1>
          <p class="text-xl text-gray-700 dark:text-gray-300 print:text-gray-700 mb-3 print:text-base">
            Technical Architect / Solutions Architect | Principal Backend Engineer (Node.js · TypeScript)
          </p>
          <p class="text-lg text-gray-600 dark:text-gray-400 print:text-gray-600 mb-3 print:text-sm">
            Enterprise Distributed Systems · Event-Driven Microservices · Workflow Orchestration
          </p>
          
          <div class="flex flex-wrap gap-4 text-sm text-gray-600 dark:text-gray-400 print:text-gray-600 print:gap-3 print:text-xs">
            <span>Jaipur, Rajasthan, India</span>
            <span>•</span>
            <span>+91 82900 22508</span>
            <span>•</span>
            <a href="mailto:nsnitesh92@gmail.com" class="text-accent-600 dark:text-accent-400 print:text-accent-700 hover:underline">
              nsnitesh92@gmail.com
            </a>
            <span>•</span>
            <a href="https://www.linkedin.com/in/nitesh-sharma-90035491/" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-400 print:text-accent-700 hover:underline">
              LinkedIn
            </a>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-500 print:text-gray-600 mt-2 print:text-xs">
            Open to: Bengaluru, Delhi-NCR (Delhi/Gurugram/Noida), Hyderabad, Pune, remote-India
          </p>
        </header>
        
        <!-- Summary -->
        <section class="mb-6 print:mb-4">
          <h2 class="text-2xl font-bold mb-3 print:text-xl print:mb-2">Summary</h2>
          <p class="text-gray-700 dark:text-gray-300 print:text-gray-800 leading-relaxed print:text-sm">
            Technical Architect / Principal Backend Engineer with 11+ years of experience architecting and delivering enterprise-scale distributed systems, event-driven microservices, and workflow orchestration platforms. Expert in Node.js, TypeScript, and NestJS, with deep expertise in Kafka, RabbitMQ, Redis, Temporal, PostgreSQL, and API Gateway/BFF architectures. Proven track record leading solution design for government and enterprise platforms, defining scalable system architecture, mentoring engineering teams, and driving end-to-end delivery from RFPs to production. Strong working experience with Next.js, React, .NET, Java, and Python for full-stack and cross-platform solution delivery.
          </p>
        </section>
        
        <!-- Skills -->
        <section class="mb-6 print:mb-4">
          <h2 class="text-2xl font-bold mb-3 print:text-xl print:mb-2">Skills</h2>
          <div class="space-y-2 text-gray-700 dark:text-gray-300 print:text-gray-800 print:text-sm">
            <p><strong>Languages / Frameworks:</strong> TypeScript, Node.js, NestJS, Next.js, React, Angular, Vue; secondary: Java/Spring, .NET, Python</p>
            <p><strong>Architecture:</strong> Microservices, event-driven systems, DAG / workflow orchestration, API Gateway / BFF, OpenAPI contracts, solution design (RFP → production)</p>
            <p><strong>Messaging / Orchestration:</strong> Kafka, RabbitMQ, MQTT, Temporal, Debezium, Flink; secondary: Camunda</p>
            <p><strong>Data:</strong> PostgreSQL, Prisma, Redis, QuestDB, MongoDB, Elasticsearch, Snowflake</p>
            <p><strong>Cloud / DevOps:</strong> AWS (S3, Lambda, Glue, MSK), Docker, Kubernetes, CI/CD</p>
            <p><strong>Testing / Contracts:</strong> Jest, OpenAPI / Orval, Zod, hybrid E2E (Docker Compose + Temporal); LiveKit; secondary: Keycloak</p>
          </div>
        </section>
        
        <!-- Experience -->
        <section class="mb-6 print:mb-4">
          <h2 class="text-2xl font-bold mb-4 print:text-xl print:mb-3">Experience</h2>
          
          <div class="space-y-5 print:space-y-4">
            <!-- InTimeTec -->
            <div>
              <div class="flex justify-between items-start mb-2 print:mb-1">
                <div>
                  <h3 class="text-xl font-bold print:text-lg">InTimeTec</h3>
                  <p class="text-lg text-gray-700 dark:text-gray-300 print:text-gray-800 print:text-base">Technical Architect / Solutions Architect</p>
                </div>
                <div class="text-right">
                  <p class="font-semibold print:text-sm">Aug 2023 – Present</p>
                  <p class="text-sm text-gray-600 dark:text-gray-400 print:text-gray-700 print:text-xs">Jaipur / client engagements</p>
                </div>
              </div>
              <p class="text-gray-700 dark:text-gray-300 print:text-gray-800 mb-3 print:text-sm print:mb-2">
                Lead solution architecture and hands-on delivery across concurrent enterprise and government platforms. Define system architecture, messaging topology, workflow orchestration, and technical strategy from RFP through production, while mentoring engineering teams.
              </p>
              
              <!-- Projects -->
              <div class="ml-4 space-y-3 print:ml-3 print:space-y-2">
                <div>
                  <div class="flex justify-between items-start">
                    <h4 class="font-semibold text-gray-900 dark:text-white print:text-gray-900 print:text-sm">Nebula — Robotic Workflow & Mission Orchestration Platform</h4>
                    <span class="text-sm text-gray-600 dark:text-gray-400 print:text-gray-700 whitespace-nowrap ml-2 print:text-xs">Oct 2025 – Present</span>
                  </div>
                  <ul class="list-disc list-inside text-sm text-gray-700 dark:text-gray-300 print:text-gray-800 mt-1 space-y-1 print:text-xs">
                    <li>Architected distributed, event-driven microservices platform (NestJS, Kafka, RabbitMQ, Debezium, Redis, PostgreSQL, Flink, QuestDB, Temporal)</li>
                    <li>Designed Mission Orchestrator: generic DAG execution with node-type dispatch, I/O propagation, and resilient error handling</li>
                    <li>Established hybrid E2E testing (Jest, Docker Compose, Temporal) plus infrastructure probes</li>
                    <li>Delivered mission nodes including Robot.command and KONE elevator integration for multi-floor missions</li>
                  </ul>
                </div>
                
                <div>
                  <div class="flex justify-between items-start">
                    <h4 class="font-semibold text-gray-900 dark:text-white print:text-gray-900 print:text-sm">Strategic Office for Al-Jouf Region — Saudi Government Digital Platform</h4>
                    <span class="text-sm text-gray-600 dark:text-gray-400 print:text-gray-700 whitespace-nowrap ml-2 print:text-xs">Nov 2024 – Sept 2025</span>
                  </div>
                  <ul class="list-disc list-inside text-sm text-gray-700 dark:text-gray-300 print:text-gray-800 mt-1 space-y-1 print:text-xs">
                    <li>Led solution architecture for monorepo digital-government platform (.NET microservices + Next.js) on on-prem Kubernetes</li>
                    <li>Delivered bilingual citizen portal with AR/EN RTL/LTR support targeting WCAG 2.1 AA</li>
                    <li>Integrated Camunda BPMN, Orchard Core CMS, and Nafath + Keycloak identity</li>
                  </ul>
                </div>
                
                <div>
                  <div class="flex justify-between items-start">
                    <h4 class="font-semibold text-gray-900 dark:text-white print:text-gray-900 print:text-sm">Scenne — Video-Sharing / Social MVP</h4>
                    <span class="text-sm text-gray-600 dark:text-gray-400 print:text-gray-700 whitespace-nowrap ml-2 print:text-xs">Jun 2024 – Oct 2024</span>
                  </div>
                  <ul class="list-disc list-inside text-sm text-gray-700 dark:text-gray-300 print:text-gray-800 mt-1 space-y-1 print:text-xs">
                    <li>Architected video-sharing MVP with Node.js microservices, Redis caching, RabbitMQ orchestration</li>
                    <li>Enabled upload → FFmpeg compression → CDN playback path on AWS (S3, Lambda)</li>
                  </ul>
                </div>
                
                <div>
                  <div class="flex justify-between items-start">
                    <h4 class="font-semibold text-gray-900 dark:text-white print:text-gray-900 print:text-sm">Blue Cross of Idaho (BCI) — Healthcare Data Pipeline</h4>
                    <span class="text-sm text-gray-600 dark:text-gray-400 print:text-gray-700 whitespace-nowrap ml-2 print:text-xs">Aug 2023 – Jun 2024</span>
                  </div>
                  <ul class="list-disc list-inside text-sm text-gray-700 dark:text-gray-300 print:text-gray-800 mt-1 space-y-1 print:text-xs">
                    <li>Designed enterprise clinical data pipeline ingesting CDEs/CCD/ADT into Snowflake via AWS Glue and Kafka MSK</li>
                    <li>Migrated legacy S3 data lake into structured Snowflake datasets for analytics</li>
                  </ul>
                </div>
              </div>
            </div>
            
            <!-- Falabella -->
            <div>
              <div class="flex justify-between items-start mb-2 print:mb-1">
                <div>
                  <h3 class="text-xl font-bold print:text-lg">Falabella</h3>
                  <p class="text-lg text-gray-700 dark:text-gray-300 print:text-gray-800 print:text-base">Lead Software Engineer</p>
                </div>
                <p class="font-semibold print:text-sm">Jun 2022 – Jun 2023</p>
              </div>
              <ul class="list-disc list-inside text-sm text-gray-700 dark:text-gray-300 print:text-gray-800 space-y-1 print:text-xs">
                <li>Led backend architecture on SODIMAC B2B e-commerce microservices (Node.js)</li>
                <li>Built React UIs on Flux-style state model and integrated Firestore for real-time sync</li>
              </ul>
            </div>
            
            <!-- EPAM Systems -->
            <div>
              <div class="flex justify-between items-start mb-2 print:mb-1">
                <div>
                  <h3 class="text-xl font-bold print:text-lg">EPAM Systems</h3>
                  <p class="text-lg text-gray-700 dark:text-gray-300 print:text-gray-800 print:text-base">Lead Software Engineer</p>
                </div>
                <p class="font-semibold print:text-sm">Jul 2021 – Jun 2022</p>
              </div>
              <ul class="list-disc list-inside text-sm text-gray-700 dark:text-gray-300 print:text-gray-800 space-y-1 print:text-xs">
                <li>Delivered CTC-CDS experience APIs for Cantire Corp's Core Digital Services / ODP platform</li>
                <li>Owned microservice API modules consumed across e-commerce surfaces</li>
              </ul>
            </div>
            
            <!-- Scry Analytics -->
            <div>
              <div class="flex justify-between items-start mb-2 print:mb-1">
                <div>
                  <h3 class="text-xl font-bold print:text-lg">Scry Analytics</h3>
                  <p class="text-lg text-gray-700 dark:text-gray-300 print:text-gray-800 print:text-base">Senior Full-Stack Developer</p>
                </div>
                <p class="font-semibold print:text-sm">Feb 2019 – Jul 2021</p>
              </div>
              <ul class="list-disc list-inside text-sm text-gray-700 dark:text-gray-300 print:text-gray-800 space-y-1 print:text-xs">
                <li>Built VoCP (Voice of Cancer Patients): Node-backed platform with AI-generated insights</li>
                <li>Delivered Collatio: document visualization platform with Node.js, Angular, d3.js, MongoDB, Elasticsearch</li>
              </ul>
            </div>
            
            <!-- InTimeTec (Earlier) -->
            <div>
              <div class="flex justify-between items-start mb-2 print:mb-1">
                <div>
                  <h3 class="text-xl font-bold print:text-lg">InTimeTec</h3>
                  <p class="text-lg text-gray-700 dark:text-gray-300 print:text-gray-800 print:text-base">Senior Software Engineer</p>
                </div>
                <p class="font-semibold print:text-sm">Aug 2015 – Feb 2019</p>
              </div>
              <ul class="list-disc list-inside text-sm text-gray-700 dark:text-gray-300 print:text-gray-800 space-y-1 print:text-xs">
                <li>Developed Cartos: cloud fleet optimization platform (Node.js, Angular, Java Spring Boot, MongoDB, Elasticsearch, Redis, RabbitMQ)</li>
                <li>Established early microservices + messaging patterns (RabbitMQ) and CI/CD practices</li>
              </ul>
            </div>
          </div>
        </section>
        
        <!-- Education -->
        <section>
          <h2 class="text-2xl font-bold mb-3 print:text-xl print:mb-2">Education</h2>
          <div>
            <h3 class="text-lg font-bold print:text-base">B.Tech. (Information Technology)</h3>
            <p class="text-gray-700 dark:text-gray-300 print:text-gray-800 print:text-sm">Engineering College Bikaner / Rajasthan Technical University · 2010–2014</p>
          </div>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
