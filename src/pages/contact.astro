---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Contact"
  description="Get in touch with Nitesh Sharma to talk architecture, AI and agentic systems, or writing and speaking collaborations."
>
  <div class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl font-bold mb-4">Let's Talk</h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-12">
          Always happy to talk architecture, AI and agentic systems, or event-driven platforms — a design question, a blog post you'd push back on, or a speaking or writing collaboration. Email is the fastest way to reach me.
        </p>
        
        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <div class="bg-gradient-to-br from-accent-50 to-blue-50 dark:from-accent-900/20 dark:to-blue-900/20 rounded-lg p-8">
            <div class="flex items-start">
              <svg class="w-8 h-8 text-accent-600 dark:text-accent-400 mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <div>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Email</h2>
                <a href="mailto:nsnitesh92@gmail.com" class="text-accent-600 dark:text-accent-400 hover:underline break-all">
                  nsnitesh92@gmail.com
                </a>
              </div>
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 rounded-lg p-8">
            <div class="flex items-start">
              <svg class="w-8 h-8 text-blue-600 dark:text-blue-400 mr-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              <div>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">LinkedIn</h2>
                <a href="https://www.linkedin.com/in/nitesh-sharma-90035491/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline break-all">
                  linkedin.com/in/nitesh-sharma-90035491
                </a>
              </div>
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-gray-50 to-slate-50 dark:from-gray-800/50 dark:to-slate-800/50 rounded-lg p-8">
            <div class="flex items-start">
              <svg class="w-8 h-8 text-gray-700 dark:text-gray-300 mr-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
              </svg>
              <div>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">GitHub</h2>
                <a href="https://github.com/nitesh-2016" target="_blank" rel="noopener noreferrer" class="text-gray-700 dark:text-gray-300 hover:underline">
                  github.com/nitesh-2016
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <div class="bg-gradient-to-r from-accent-600 to-blue-600 rounded-lg p-8 text-white text-center">
          <h2 class="text-2xl font-bold mb-4">Thinking through an architecture problem?</h2>
          <p class="mb-6 text-accent-50">
            I write about the trade-offs behind real platforms: orchestration, contracts, event-driven design and AI in production.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="/nitesh-portfolio/blog"
              class="inline-flex items-center px-6 py-3 bg-white text-accent-600 font-medium rounded-lg hover:bg-accent-50 transition-colors"
            >
              Read the Blog
            </a>
            <a
              href="mailto:nsnitesh92@gmail.com"
              class="inline-flex items-center px-6 py-3 bg-accent-700 hover:bg-accent-800 text-white font-medium rounded-lg transition-colors"
            >
              Email Me
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
