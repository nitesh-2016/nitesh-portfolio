---
import { getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content } = await post.render();
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const heroSrc = `${base}${post.data.heroImage.replace(/^\//, '')}`;
const ogImage = `${base}${post.data.heroImage.replace(/^\//, '')}`;
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
>
  <article class="py-12 bg-white dark:bg-gray-900 min-h-[70vh]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <p class="mb-6">
          <a
            href={`${base}blog/`}
            class="text-sm font-medium text-accent-700 dark:text-accent-400 hover:underline"
          >
            ← Back to Blog
          </a>
        </p>

        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400 mb-4">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {
              post.data.tags.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="text-accent-700 dark:text-accent-400">{tag}</span>
                    ))}
                  </span>
                </>
              )
            }
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white leading-tight mb-4">
            {post.data.title}
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
            {post.data.description}
          </p>
        </header>

        <img
          src={heroSrc}
          alt=""
          class="w-full aspect-[16/9] object-cover rounded-lg mb-10"
          width="1280"
          height="720"
        />

        <div
          class="prose prose-lg dark:prose-invert max-w-none
            prose-headings:scroll-mt-24
            prose-a:text-accent-700 dark:prose-a:text-accent-400
            prose-code:before:content-none prose-code:after:content-none
            prose-pre:bg-gray-900 prose-pre:text-gray-100"
        >
          <Content />
        </div>
      </div>
    </div>
  </article>
</MainLayout>
